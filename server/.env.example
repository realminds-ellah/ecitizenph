# Real eVerify verify/query endpoint URL (not published in the SDK docs
# excerpt this integration was built from — get it from the hackathon
# organizers and fill it in here).
EVERIFY_VERIFY_URL=

# Private secret key for server-to-server calls to eVerify. NEVER put this
# in the root .env or anything prefixed VITE_ — that would ship it to the
# browser. This file (server/.env) is git-ignored.
EVERIFY_SECRET_KEY=

# eMessage (SMS) — {{base_url}} and {{api_token}} from the eMessage API.
# Used server-side only (server/emessage.mjs) to send a confirmation SMS
# after a successful eVerify response. Never exposed to the browser, and
# not reachable as a public route — see the comment at the top of
# emessage.mjs for why.
EMESSAGE_BASE_URL=
EMESSAGE_API_TOKEN=

# eReport (eGov complaint/incident reporting) — {{base}} and {{access_code}}
# from the eReport API. Used server-side only (server/ereport.mjs).
EREPORT_BASE_URL=
EREPORT_ACCESS_CODE=

# UNCONFIRMED — how the generated eReport token is attached to authenticated
# calls (datasets/submit_complaint) isn't documented in the API material we
# integrated from. Defaults to `Authorization: Bearer <token>`; override here
# if eGov's real API expects something else (e.g. a custom header) without
# touching code. See the comment block at the top of server/ereport.mjs.
EREPORT_AUTH_HEADER_NAME=Authorization
EREPORT_AUTH_HEADER_PREFIX=Bearer

# eGovPH SSO — high priority per the integration review, but we were not
# given sandbox credentials for it. Scaffolded (/api/sso/exchange, 501 until
# set) so a real client_id/secret can be dropped in without touching code.
# Until then, Profile tab's "Linked Accounts" simulates the UX this buys:
# one verified eVerify session auto-"links" SSS/PhilHealth/Pag-IBIG/UMID
# instead of separate logins.
EGOVPH_SSO_TOKEN_URL=
EGOVPH_SSO_CLIENT_SECRET=

# DBM Compass (budget transparency) — situational, strongest fit is
# cross-referencing eReport complaints about project delays/fund misuse
# against real appropriations data (SAAODB/NCA/SARO/LGSF). Scaffolded
# (/api/dbm-compass/appropriations), not wired to a real sandbox.
DBM_COMPASS_BASE_URL=
DBM_COMPASS_API_KEY=

# eGovPay (digital payments) — situational; nothing in this prototype
# charges a fee yet, so there's no real UI flow to attach it to.
# Scaffolded (/api/egovpay/checkout) for whenever that changes.
EGOVPAY_BASE_URL=
EGOVPAY_API_KEY=

# eGov AI (document intelligence) — situational; there's no file-upload
# surface in this prototype yet (ApplyModal is a self-attestation checklist
# by design). Scaffolded (/api/egov-ai/classify) for whenever one exists.
EGOV_AI_BASE_URL=
EGOV_AI_API_KEY=

PORT=8787
